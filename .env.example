# Local sim: run `npm run sim:php` in another terminal (serves php-sim on :8080).
# Vite proxies browser ./sim_api.php → http://127.0.0.1:8080/sim_api.php
# Leave VITE_SIM_API_URL unset for that default.
# VITE_SIM_API_URL=

# Step-3 assistant backend (your own server). Leave unset to use built-in rules.
# Start server with: cd server && npm install && npm start
# VITE_ASSISTANT_API_URL=http://localhost:8787/api/assistant
