# Optional: point the schematic editor at a remote/local sim_api.php during Vite dev.
# Example:
#   VITE_SIM_API_URL=./sim_api.php
# When hosted beside the real PHP on the SimulAI server, leave unset (defaults to ./sim_api.php).
# VITE_SIM_API_URL=

# Step-3 assistant backend (your own server). Leave unset to use built-in rules.
# Start server with: cd server && npm install && npm start
# VITE_ASSISTANT_API_URL=http://localhost:8787/api/assistant
