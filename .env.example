# Local sim: run `npm run sim:php` in another terminal (serves php-sim on :8080).
# Vite proxies browser ./sim_api.php → http://127.0.0.1:8080/sim_api.php
# Leave VITE_SIM_API_URL unset for that default.
# VITE_SIM_API_URL=

# Public origin for Projects → Share links (defaults to DO when on localhost).
# VITE_SHARE_ORIGIN=http://165.22.212.92:8088/

# Step-3 assistant backend (complex Q&A + multi-step edits).
# Start: cd server && npm install && npm start  (needs GEMINI_API_KEY in server/.env)
# Vite proxies /api/assistant → http://127.0.0.1:8787 when unset.
# VITE_ASSISTANT_API_URL=http://localhost:8787/api/assistant
